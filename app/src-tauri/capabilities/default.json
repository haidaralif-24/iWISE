{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the Pip main window only. The chat window is created at runtime and is deliberately not listed here, so a third-party page can never call a Tauri command.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/.pip/notes/*" }]
    },
    "notification:default",
    "dialog:default",
    "dialog:allow-confirm",
    "dialog:allow-open",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging"
  ]
}
